{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "research_task_id", "attempt", "answers", "claims", "unconfirmed", "scope_expansion"],
  "properties": {
    "status": {"enum": ["COMPLETE", "BLOCKED", "SCOPE_EXPANSION_REQUIRED"]},
    "research_task_id": {"type": "string", "pattern": "^R[1-3]$"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
    "answers": {"type": "array", "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["question_id", "answer", "evidence_ids"], "properties": {"question_id": {"type": "string", "pattern": "^Q[1-9][0-9]{0,2}$"}, "answer": {"type": "string", "minLength": 1, "maxLength": 6000}, "evidence_ids": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "maxLength": 100}}}}},
    "claims": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["claim", "evidence_ids"], "properties": {"claim": {"type": "string", "minLength": 1, "maxLength": 4000}, "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "maxLength": 100}}}}},
    "unconfirmed": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "scope_expansion": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "symbol", "reason", "evidence_ids"],
          "properties": {
            "path": {"type": "string", "minLength": 1, "maxLength": 500},
            "symbol": {"type": ["string", "null"], "maxLength": 500},
            "reason": {"type": "string", "minLength": 1, "maxLength": 4000},
            "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "maxLength": 100}}
          }
        }
      ]
    }
  }
}
