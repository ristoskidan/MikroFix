[Unit]
Description=MikroFIX local agent supervisor
After=ollama.service

[Service]
Type=simple
WorkingDirectory=/home/mikrofix/MikroFIX_Service_v30_R9_LINUX_DEV
ExecStart=/usr/bin/python3 tools/mikrofix_supervisor.py run
Restart=on-failure
RestartSec=5

# SAFETY BOUNDARY:
# This example is documentation only. Before enabling it, initialize a run,
# execute `workers start`, and approve `grant-lease`. `run` is a `resume` alias:
# it verifies READY workers and the bound lease but never bypasses the GUI.

[Install]
WantedBy=default.target
