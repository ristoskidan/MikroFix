{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dossier_sha256", "verdict", "research_task_id", "reason", "created_at", "verdict_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "dossier_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verdict": {"enum": ["APPROVE", "REVISE", "REJECT"]},
    "research_task_id": {"type": ["string", "null"], "pattern": "^R[1-3]$"},
    "reason": {"type": "string", "maxLength": 4000},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 100},
    "verdict_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
