{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "research_task_id", "objective", "question_ids", "allowed_scope", "required_evidence", "reason_for_overlap", "original_task_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "research_task_id": {"type": "string", "pattern": "^R[1-3]$"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 2000},
    "question_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^Q[1-9][0-9]{0,2}$"}},
    "allowed_scope": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": {"kind": {"enum": ["file", "directory"]}, "path": {"type": "string", "minLength": 1, "maxLength": 500}}}},
    "required_evidence": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "reason_for_overlap": {"type": ["string", "null"], "maxLength": 4000},
    "original_task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
