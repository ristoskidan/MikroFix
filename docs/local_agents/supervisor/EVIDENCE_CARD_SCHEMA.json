{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "research_task_id", "original_task_sha256", "attempt", "tool_result_event_id", "raw_tool_result_sha256", "tool", "normalized_arguments", "canonical_path", "actual_start_line", "actual_end_line", "content_bytes_sha256", "excerpt", "symbol"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^E-R[1-3]-A[1-3]-[0-9]{4}$"},
    "research_task_id": {"type": "string", "pattern": "^R[1-3]$"},
    "original_task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
    "tool_result_event_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "raw_tool_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tool": {"type": "string", "minLength": 1, "maxLength": 100},
    "normalized_arguments": {"type": "object", "maxProperties": 20},
    "canonical_path": {"type": "string", "minLength": 1, "maxLength": 500},
    "actual_start_line": {"type": ["integer", "null"], "minimum": 1},
    "actual_end_line": {"type": ["integer", "null"], "minimum": 1},
    "content_bytes_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "excerpt": {"type": "string", "minLength": 1, "maxLength": 2000},
    "symbol": {"type": ["string", "null"], "maxLength": 500}
  }
}
